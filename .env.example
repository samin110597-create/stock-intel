# Copy to .env and fill in. Any key you omit simply disables that provider —
# the router reports it as unconfigured rather than failing silently.

# Price data (the router tries these in order)
TWELVEDATA_KEY=
POLYGON_KEY=
FMP_KEY=
FINNHUB_KEY=
ALPHAVANTAGE_KEY=

# Macro. Free, no rate limit worth worrying about, and there is no second
# source for TIPS real yields — get this one.
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
